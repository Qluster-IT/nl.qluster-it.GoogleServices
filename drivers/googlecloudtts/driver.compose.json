{
    "id": "googlecloudtts",
    "name": {
      "en": "Text-To-Speech",
      "nl": "Tekst-Naar-Spraak"
    },
    "class": "other",
    "capabilities": [
      "device_url",
      "device_duration"
    ],
    "images": {
      "large": "{{driverAssetsPath}}/images/large.png",
      "small": "{{driverAssetsPath}}/images/small.png"
    },
    "pair": [
      {
        "id": "list_devices",
        "template": "list_devices",
        "navigation": {
          "next": "add_my_devices"
        },
        "options": {
          "singular": true
        }
      },
      {
        "id": "add_my_devices",
        "template": "add_devices"
      }
    ],
    "repair": [
      {
        "id": "fix_list_devices",
        "template": "list_devices",
        "navigation": {
          "next": "done_fix_my_devices"
        },
        "options": {
          "singular": true
        }
      },
      {
        "id": "done_fix_my_devices",
        "template": "done"
      }
    ],
    "settings": [
      {
        "id": "speakingRate",
        "type": "number",
        "label": {
          "en": "Speed %",
          "nl": "Snelheid %"
        },
        "min": 0.25,
        "max": 4,
        "step": 0.01,          
        "labelMultiplier": 100,
        "labelDecimals": 0
      },
      {
        "id": "pitch",
        "type": "number",
        "label": "Pitch",
        "min": -20,
        "max": 20,
        "step": 0.1
      },
      {
        "id": "delay",
        "type": "number",
        "label": {
          "en": "Delay for each file to (finish) playing in ms",
          "nl": "Vertraging voor elk bestand om te (eindige) spelen in ms"
        },
        "value": 1000,
        "hint": {
          "en": "Extra waiting time before (finishing) playing the next file",
          "nl": "Extra wachttijd voor het (eindigevan het ) spelen van het bestand"
        }
      },
      {
        "id": "deviceprofile",
        "type": "dropdown",
        "label": {
          "en": "Device Profile"
        },
        "hint": {
          "en": "Select an 'audio effect' profile that is applied on (post synthesized) text to speech.\r\n"
        },
        "values": [
          {
            "id": "wearable-class-device",
            "name": "wearable-class-device",
            "label": {
              "en": "Smart watches and other wearables, like Apple Watch, Wear OS watch (wearable-class-device)"
            }
          },
          {
            "id": "handset-class-device",
            "name": "handset-class-device",
            "label": {
              "en": "Smartphones, like Google Pixel, Samsung Galaxy, Apple iPhone (handset-class-device)"
            }
          },
          {
            "id": "headphone-class-device",
            "name": "headphone-class-device",
            "label": {
              "en": "Earbuds or headphones for audio playback, like Sennheiser headphones (headphone-class-device)"
            }
          },
          {
            "id": "small-bluetooth-speaker-class-device",
            "name": "small-bluetooth-speaker-class-device",
            "label": {
              "en": "Small home speakers, like Google Home Mini (small-bluetooth-speaker-class-device)"
            }
          },
          {
            "id": "medium-bluetooth-speaker-class-device",
            "name": "medium-bluetooth-speaker-class-device",
            "label": {
              "en": "Smart home speakers, like Google Home (medium-bluetooth-speaker-class-device)"
            }
          },
          {
            "id": "large-home-entertainment-class-device",
            "name": "large-home-entertainment-class-device",
            "label": {
              "en": "Home entertainment systems or smart TVs, like Google Home Max, LG TV (large-home-entertainment-class-device)"
            }
          },
          {
            "id": "large-automotive-class-device",
            "name": "large-automotive-class-device",
            "label": {
              "en": "Car speakers (large-automotive-class-device)"
            }
          },
          {
            "id": "telephony-class-application",
            "name": "telephony-class-application",
            "label": {
              "en": "Interactive Voice Response (IVR) systems (telephony-class-application)"
            }
          }
        ]
      },
      {
        "id": "volumeGainDb",
        "type": "number",
        "label": "Volume Gain (Db)",
        "min": -96,
        "max": 16,
        "step": 0.1,        
        "hint": {
          "en": "Increase the volume with this amount of Db.\r\nStrongly recommend not to exceed +10 (dB) as there's usually no effective increase in loudness for any value greater than that."
        }
      }

    ]
  }