    {
      "id": "announce_googletts",
      "title": {
        "en": "Announce text on a speaker",
        "nl": "Spreek tekst uit op een luidspreker"
      },
      "titleFormatted": {
        "en": "Announce [[text]] on [[speaker]] with volume [[volume]]%, Sonos: [[sonos_mode]], then [[completion]]",
        "nl": "Spreek [[text]] uit op [[speaker]] met volume [[volume]]%, Sonos: [[sonos_mode]], daarna [[completion]]"
      },
      "hint": {
        "en": "Plays up to 200 characters on a Google Cast, Sonos, or compatible UPnP/DLNA speaker on your local network. Supports BLL coding in the text field. Choose Wait to finish to continue the Flow only after the announcement finishes and previous playback is restored where applicable. For Sonos, Play Separately sends a native announcement directly to the selected rooms. It can play over current audio and leaves groups untouched. Choose Play in Sync when the rooms need to play together.",
        "nl": "Speelt maximaal 200 tekens af op een Google Cast-, Sonos- of compatibele UPnP/DLNA-luidspreker op je lokale netwerk. BLL-codering wordt ondersteund in het tekstveld. Kies Wachten tot klaar om de Flow pas verder te laten gaan als de aankondiging is afgelopen en de vorige weergave waar nodig is hersteld. Bij Sonos stuurt Apart afspelen een ingebouwde aankondiging rechtstreeks naar de gekozen kamers. De aankondiging kan over het huidige geluid heen spelen en laat groepen intact. Kies Synchroon afspelen als de kamers tegelijk moeten afspelen."
      },
      "args": [
        {
          "name": "text",
          "type": "text",
          "placeholder": {
            "en": "Text to announce (* BLL supported)",
            "nl": "Tekst om uit te spreken (* BLL ondersteund)"
          },
          "title": {
            "en": "Text",
            "nl": "Tekst"
          }
        },
        {
          "name": "speaker",
          "type": "autocomplete",
          "placeholder": {
            "en": "Choose a speaker",
            "nl": "Kies een luidspreker"
          },
          "required": false,
          "title": {
            "en": "Speaker",
            "nl": "Luidspreker"
          }
        },
        {
          "name": "volume",
          "type": "number",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "placeholder": {
            "en": "Speaker volume (%) (optional)",
            "nl": "Luidsprekervolume (%) (optioneel)"
          },
          "required": false,
          "title": {
            "en": "Speaker volume (%)",
            "nl": "Luidsprekervolume (%)"
          }
        },
        {
          "name": "sonos_mode",
          "type": "dropdown",
          "required": false,
          "title": {
            "en": "Use device default",
            "nl": "Gebruik apparaatstandaard",
            "da": "Brug enhedsstandard",
            "de": "Gerätestandard verwenden",
            "es": "Usar el valor del dispositivo",
            "fr": "Utiliser le réglage de l’appareil",
            "it": "Usa il valore del dispositivo",
            "no": "Bruk enhetsstandard",
            "sv": "Använd enhetens standard",
            "pl": "Użyj ustawienia urządzenia",
            "ru": "Использовать настройку устройства",
            "ko": "기기 기본값 사용",
            "ar": "استخدام إعداد الجهاز"
          },
          "values": [
            {
              "id": "default",
              "label": {
                "en": "Use device default",
                "nl": "Gebruik apparaatstandaard",
                "da": "Brug enhedsstandard",
                "de": "Gerätestandard verwenden",
                "es": "Usar el valor del dispositivo",
                "fr": "Utiliser le réglage de l’appareil",
                "it": "Usa il valore del dispositivo",
                "no": "Bruk enhetsstandard",
                "sv": "Använd enhetens standard",
                "pl": "Użyj ustawienia urządzenia",
                "ru": "Использовать настройку устройства",
                "ko": "기기 기본값 사용",
                "ar": "استخدام إعداد الجهاز"
              }
            },
            {
              "id": "selected",
              "label": {
                "en": "Play Separately",
                "nl": "Apart afspelen",
                "da": "Afspil separat",
                "de": "Getrennt abspielen",
                "es": "Reproducir por separado",
                "fr": "Lire séparément",
                "it": "Riproduci separatamente",
                "no": "Spill av separat",
                "sv": "Spela separat",
                "pl": "Odtwarzaj osobno",
                "ru": "Воспроизводить отдельно",
                "ko": "개별 재생",
                "ar": "تشغيل منفصل"
              }
            },
            {
              "id": "sync",
              "label": {
                "en": "Play in Sync",
                "nl": "Synchroon afspelen",
                "da": "Afspil synkront",
                "de": "Synchron abspielen",
                "es": "Reproducir en sincronía",
                "fr": "Lecture synchronisée",
                "it": "Riproduci in sincronia",
                "no": "Spill av synkront",
                "sv": "Spela synkront",
                "pl": "Odtwarzaj synchronicznie",
                "ru": "Воспроизводить синхронно",
                "ko": "동기 재생",
                "ar": "تشغيل متزامن"
              }
            }
          ]
        },
        {
