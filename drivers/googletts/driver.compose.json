  "settings": [
    {
      "id": "trigger_when_announcing",
      "type": "checkbox",
      "label": {
        "en": "Run When cards for speaker announcements",
        "nl": "Activeer Wanneer-kaarten bij luidsprekeraankondigingen"
      },
      "hint": {
        "en": "For direct Google Cast, Sonos and UPnP/DLNA playback: turn on to run the audio URL When card after playback starts successfully. Turn off to play without triggering that card.",
        "nl": "Bij direct afspelen via Google Cast, Sonos en UPnP/DLNA: schakel in om de Wanneer-kaart met de audio-URL te activeren nadat het afspelen succesvol is gestart. Schakel uit om zonder die kaart af te spelen."
      },
      "value": false
    },
    {
      "id": "announcement_group_sonos",
      "type": "checkbox",
      "label": {
        "en": "Temporarily group Sonos rooms",
        "nl": "Sonos-kamers tijdelijk groeperen"
      },
      "hint": {
        "en": "With All speakers, group compatible Sonos rooms for synchronized speech, then restore their groups. Other speakers play separately.",
        "nl": "Groepeer bij Alle luidsprekers compatibele Sonos-kamers voor gesynchroniseerde spraak en herstel daarna de groepen. Andere luidsprekers spelen afzonderlijk."
      },
      "value": true
    },
    {
      "id": "announcement_resume",
      "type": "checkbox",
      "label": {
        "en": "Resume previous playback",
        "nl": "Vorige weergave hervatten"
      },
      "hint": {
        "en": "After direct speaker playback, restore the previous source and position where supported. Unsupported features are skipped.",
        "nl": "Herstel na direct afspelen de vorige bron en positie waar dit wordt ondersteund. Niet-ondersteunde functies worden overgeslagen."
      },
      "value": true
    },
