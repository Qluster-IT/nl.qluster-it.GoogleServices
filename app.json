{
  "id": "nl.qluster-it.GoogleServices",
  "version": "1.2.0",
  "compatibility": ">=1.5.0",
  "sdk": 2,
  "brandColor": "#8DB000",
  "name": {
    "en": "Google Services",
    "nl": "Google Services"
  },
  "description": {
    "en": "Setup your favorite Google voice for your speakers",
    "nl": "Stel je favoriete Google stem in voor je speakers"
  },
  "category": [
    "tools"
  ],
  "permissions": [],
  "images": {
    "large": "/assets/images/large.png",
    "small": "/assets/images/small.png"
  },
  "source": "https://bitbucket.org/QlusterIT/nl.qluster-it.googleservices/",
  "bugs": {
    "url": "https://bitbucket.org/QlusterIT/nl.qluster-it.googleservices/issues"
  },
  "homeyCommunityTopicId": 43257,
  "author": {
    "name": "Arie J. Godschalk",
    "email": "arie@qluster-it.nl"
  },
  "flow": {
    "triggers": [
      {
        "id": "url_trigger",
        "title": {
          "en": "Url triggered"
        },
        "titleFormatted": {
          "en": "Url triggered"
        },
        "tokens": [
          {
            "name": "url",
            "type": "string",
            "title": {
              "en": "Url"
            }
          },
          {
            "name": "duration",
            "type": "number",
            "title": {
              "en": "Duration",
              "nl":"Duur"
            }
          },
          {
            "name": "text",
            "type": "string",
            "title": {
              "en": "Text",
              "nl": "Tekst"
            }
          }
        ],
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=googletts"
          }
        ]
      },
      {
        "id": "cloudurl_trigger",
        "title": {
          "en": "Url triggered"
        },
        "titleFormatted": {
          "en": "Url triggered"
        },
        "tokens": [
          {
            "name": "url",
            "type": "string",
            "title": {
              "en": "Url"
            }
          },
          {
            "name": "text",
            "type": "string",
            "title": {
              "en": "Text",
              "nl": "Tekst"
            }
          },
          {
            "name": "duration",
            "type": "number",
            "title": {
              "en": "Duration",
              "nl": "Duur"
            }
          }
        ],
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=googlecloudtts"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "start_googletts",
        "title": {
          "en": "Start TTS",
          "nl": "Begin TTS"
        },
        "titleFormatted": {
          "en": "Start saying [[text]]",
          "nl": "Begin te zeggen [[text]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=googletts"
          },
          {
            "name": "text",
            "type": "text",
            "placeholder": {
              "en": "Text",
              "nl": "Tekst"
            }
          }
        ]
      },
      {
        "id": "start_googletts_slow",
        "title": {
          "en": "Start TTS slow speed",
          "nl": "Begin TTS langzame snelheid"
        },
        "titleFormatted": {
          "en": "Start saying [[text]] slow speed",
          "nl": "Begin te zeggen [[text]] langzame snelheid"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=googletts"
          },
          {
            "name": "text",
            "type": "text",
            "placeholder": {
              "en": "Text",
              "nl": "Tekst"
            }
          }
        ]
      },
      {
        "id": "start_googlecloudtts",
        "title": {
          "en": "Start TTS",
          "nl": "Begin TTS"
        },
        "titleFormatted": {
          "en": "Start saying [[text]]",
          "nl": "Begin te zeggen [[text]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=googlecloudtts"
          },
          {
            "name": "text",
            "type": "text",
            "placeholder": {
              "en": "Text",
              "nl": "Tekst"
            }
          }
        ]
      },
      {
        "id": "start_googlecloudtts_speed",
        "title": {
          "en": "Start TTS at speed",
          "nl": "Begin TTS op snelheid"
        },
        "titleFormatted": {
          "en": "Start saying [[text]] speed [[speakingRate]]",
          "nl": "Begin te zeggen [[text]] snelheid [[speakingRate]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=googlecloudtts"
          },
          {
            "name": "text",
            "type": "text",
            "placeholder": {
              "en": "Text",
              "nl": "Tekst"
            }
          },
          {
            "name": "speakingRate",
            "type": "range",
            "placeholder": {
              "en": "Speed",
              "nl": "Snelheid"
            },
            "min": 0.25,
            "max": 4,
            "step": 0.01
          }
        ]
      },
      {
        "id": "start_googlecloudtts_speed_pitch",
        "title": {
          "en": "Start TTS at speed with pitch"
        },
        "titleFormatted": {
          "en": "Start saying for [[text]] speed [[speakingRate]] pitch [[pitch]]",
          "nl": "Begin te zeggen [[text]] snelheid [[speakingRate]] toonhoogte [[pitch]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=googlecloudtts"
          },
          {
            "name": "text",
            "type": "text",
            "placeholder": {
              "en": "Text",
              "nl": "Tekst"
            }
          },
          {
            "name": "speakingRate",
            "type": "range",
            "placeholder": {
              "en": "Speed",
              "nl": "Snelheid"
            },
            "min": 0.25,
            "max": 4,
            "step": 0.01
          },
          {
            "name": "pitch",
            "type": "range",
            "placeholder": {
              "en": "Pitch",
              "nl": "Toonhoogte"
            },
            "min": -20,
            "max": 20,
            "step": 0.1
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "id": "googletts",
      "name": {
        "en": "Text-To-Speech (Non-Cloud)",
        "nl": "Tekst-Naar-Spraak (Non-Cloud)"
      },
      "class": "other",
      "capabilities": [],
      "images": {
        "large": "/drivers/googletts/assets/images/large.png",
        "small": "/drivers/googletts/assets/images/small.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_my_devices"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "add_my_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "languagecode",
          "type": "dropdown",
          "label": {
            "en": "Language"
          },
          "value": "en-GB",
          "hint": {
            "en": "Choose the language for this device"
          },
          "values": [
            {
              "id": "en-GB",
              "name": "en-GB",
              "label": {
                "en": "English (GB)",
                "nl": "Engels (GB)"
              }
            },
            {
              "id": "en-US",
              "name": "en-US",
              "label": {
                "en": "English (US)",
                "nl": "Engels (US)"
              }
            },
            {
              "id": "nl-NL",
              "name": "nl-NL",
              "label": {
                "en": "Dutch (NL)",
                "nl": "Nederlands (NL)"
              }
            },
            {
              "id": "nl-BE",
              "name": "nl-BE",
              "label": {
                "en": "Dutch (BE)",
                "nl": "Nederlands (BE)"
              }
            },
            {
              "id": "de-DE",
              "name": "de-DE",
              "label": {
                "en": "German (DE)",
                "nl": "Duits (DE)"
              }
            },
            {
              "id": "de-LU",
              "name": "de-LU",
              "label": {
                "en": "German (LU)",
                "nl": "Duits (LU)"
              }
            },
            {
              "id": "fr-FR",
              "name": "fr-FR",
              "label": {
                "en": "French (FR)",
                "nl": "Frans (FR)"
              }
            },
            {
              "id": "fr-BE",
              "name": "fr-BE",
              "label": {
                "en": "French (BE)",
                "nl": "Frans (BE)"
              }
            },
            {
              "id": "es-ES",
              "name": "es-ES",
              "label": {
                "en": "Spanish (ES)",
                "nl": "Spaans (ES)"
              }
            },
            {
              "id": "it-IT",
              "name": "it-IT",
              "label": {
                "en": "Italian (IT)",
                "nl": "Italiaans (IT)"
              }
            },
            {
              "id": "sv-SV",
              "name": "sv-SV",
              "label": {
                "en": "Swedish (SV)",
                "nl": "Zweeds (SV)"
              }
            },
            {
              "id": "no-NO",
              "name": "no-NO",
              "label": {
                "en": "Norwegian (NO)",
                "nl": "Noors (NO)"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "googlecloudtts",
      "name": {
        "en": "Text-To-Speech",
        "nl": "Tekst-Naar-Spraak"
      },
      "class": "other",
      "capabilities": [],
      "images": {
        "large": "/drivers/googlecloudtts/assets/images/large.png",
        "small": "/drivers/googlecloudtts/assets/images/small.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_my_devices"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "add_my_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "voice",
          "type": "dropdown",
          "label": {
            "en": "Voice",
            "nl": "Stem"
          },
          "hint": {
            "en": "Choose the voice for this device",
            "nl": "Kies de stem voor dit apparaat"
          },
          "values": [
            {
              "id": "default",
              "name": "Default",
              "label": {
                "en": "Default voice",
                "nl": "Standaard stem"
              }
            }
          ]
        },
        {
          "id": "speakingRate",
          "type": "number",
          "label": {
            "en": "Speed",
            "nl": "Snelheid"
          },
          "min": 0.25,
          "max": 4,
          "step": 0.01
        },
        {
          "id": "pitch",
          "type": "number",
          "label": "Pitch",
          "min": -20,
          "max": 20,
          "step": 0.1
        }
      ]
    }
  ]
}